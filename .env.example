# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Postgres connection string. See CLAUDE.md's Phase 3 notes for local setup.
DATABASE_URL=postgresql+psycopg2://simpleapp:simpleapp_dev@localhost/simpleapp

# Random key used to sign the session cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# The one login account this app supports (see CLAUDE.md's Phase 4 notes — single-user
# by design). Generate APP_PASSWORD_HASH with:
#   .venv/bin/python scripts/hash_password.py
# (prompts for a password via getpass — never types it into a file or shell history)
APP_USERNAME=
APP_PASSWORD_HASH=
